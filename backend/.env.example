# MORPHEUS backend env. Copy to backend/.env (gitignored) for local dev.
ENVIRONMENT=development
# Production: ENVIRONMENT=production, AUTH_DEV_MODE=false, strong SECRET_KEY.
AUTH_DEV_MODE=true

# Local dev: SQLite (zero setup). Docker/prod: Postgres + pgvector.
# Supabase: Project Settings → Database → URI (use the transaction pooler on :6543).
DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# JWT signing — generate for real deployments:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Supabase Storage (Vercel/prod). Create a private bucket named `morpheus`.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=morpheus

# First cloud boot: create tables + seed demo users/standards.
AUTO_MIGRATE=false
SEED_DEMO_DATA=true

# Neo4j (graph projection — Phase 3). Health reports its status; optional in Phase 1.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# AI + embedding providers. Stub fallback runs with no keys (LLM abstains).
LLM_PROVIDER=stub
EMBEDDING_PROVIDER=stub
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Seed users (dev only — override in production). Real TLD required by validators.
SEED_ADMIN_EMAIL=admin@morpheus.example.com
SEED_ADMIN_PASSWORD=morpheus-admin
